views:
  - type: table
    name: View
    filters:
      and:
        - file.inFolder("Art Design")
    sort: []
  - type: table
    name: View 2
  - type: cards
    name: card
    filters:
      and:
        - file.inFolder("Art Design/design chose project")
    order:
      - file.name
    image: note.cover
    cardSize: 270
    imageAspectRatio: 1.15
    imageFit: contain
