filters:
  and:
    - file.inFolder("Art Design")
formulas:
  CardCover: image(text.embed)
views:
  - type: table
    name: View
    filters:
      and:
        - file.inFolder("Art Design")
        - '!file.name.endsWith(".base")'
    order:
      - file.name
    imageAspectRatio: 1
    image: formula.CardCover
    rowHeight: medium
  - type: table
    name: View 2
  - type: table
    name: View 3
    order:
      - file.name
      - formula.CardCover
    sort:
      - property: formula.CardCover
        direction: DESC
    rowHeight: tall
